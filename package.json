{
  "name": "digital-crud-api-tf",
  "version": "1.0.0",
  "description": "API CRUD con API Gateway, Lambda y DynamoDB (Terraform) - Arquitectura Hexagonal + NestJS",
  "scripts": {
    "compile": "tsc",
    "build": "npm run compile && node scripts/build.mjs",
    "build:ci": "npm run test && npm run build",
    "test": "jest --coverage --maxWorkers=2",
    "test:watch": "jest --watchAll",
    "start:local": "npm run compile && node scripts/local-server.js",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "author": "Luiggi Huaman",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.478.0",
    "@aws-sdk/client-ssm": "3.478.0",
    "@aws-sdk/lib-dynamodb": "3.478.0",
    "@middy/core": "4.5.5",
    "@nestjs/common": "10.4.19",
    "@nestjs/core": "10.4.19",
    "joi": "17.13.3",
    "reflect-metadata": "0.1.14",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.16",
    "@types/aws-lambda": "^8.10.157",
    "@types/jest": "^29.5.14",
    "@types/node": "20.10.4",
    "@types/uuid": "^9.0.8",
    "@types/fs-extra": "11.0.4",
    "jest": "29.7.0",
    "jest-cucumber": "4.5.0",
    "prettier": "3.1.0",
    "ts-jest": "29.1.1",
    "typescript": "5.3.3",
    "fs-extra": "11.3.0"
  }
}
