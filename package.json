{
  "name": "digital-crud-api-tf",
  "version": "1.0.0",
  "description": "API CRUD con API Gateway, Lambda y DynamoDB (Terraform) - Arquitectura Hexagonal + NestJS",
  "scripts": {
    "compile": "tsc",
    "build": "npm run compile && node scripts/build.mjs",
    "build:tf": "npm run build && node scripts/prepare-tf-build.mjs",
    "build:ci": "npm run test && npm run build",
    "test": "jest --coverage --maxWorkers=2",
    "test:watch": "jest --watchAll",
    "start:local": "npm run compile && node scripts/local-server.js",
    "auth:header": "node scripts/get-auth-header.js",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "author": "Luiggi Huaman",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1085.0",
    "@aws-sdk/client-ssm": "3.1085.0",
    "@aws-sdk/lib-dynamodb": "3.1085.0",
    "@middy/core": "4.5.5",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "joi": "17.13.4",
    "reflect-metadata": "0.2.2",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1085.0",
    "@nestjs/testing": "11.1.28",
    "@types/aws-lambda": "8.10.157",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "@types/uuid": "9.0.8",
    "fs-extra": "11.3.0",
    "jest": "29.7.0",
    "jest-cucumber": "4.5.0",
    "prettier": "3.1.0",
    "ts-jest": "29.1.1",
    "typescript": "5.3.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
